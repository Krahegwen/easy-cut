{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: los comandos propios, escuchar eventos (soltar ficheros) y actualizarse (buscar, descargar, instalar y reiniciar) y la biblioteca de sonidos y efectos (descargas solo de las releases de GitHub).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:resources:allow-close",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    "allow-run-tool",
    "allow-cancel-job",
    "allow-make-thumbnail",
    "allow-make-waveform",
    "allow-cache-entry",
    "allow-promote-cache-file",
    "allow-discard-cache-file",
    "allow-write-temp-text-file",
    "allow-pick-videos",
    "allow-pick-output-folder",
    "allow-get-output-folder",
    "allow-list-file-names",
    "allow-path-exists",
    "allow-delete-partial-output",
    "allow-output-file-size",
    "allow-append-save-log",
    "allow-open-file",
    "allow-reveal-in-folder",
    "allow-copy-file-to-clipboard",
    "allow-clipboard-sequence",
    "allow-clipboard-files",
    "allow-save-autosave",
    "allow-load-autosave",
    "allow-clear-autosave",
    "allow-save-project",
    "allow-load-project",
    "allow-recording-begin",
    "allow-recording-append",
    "allow-recording-finish",
    "allow-recording-cleanup",
    "allow-library-status",
    "allow-library-fetch",
    "allow-library-catalog"
  ]
}
