{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: solo los comandos propios y escuchar eventos (soltar ficheros).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-run-tool",
    "allow-cancel-job",
    "allow-make-thumbnail",
    "allow-make-waveform",
    "allow-cache-entry",
    "allow-promote-cache-file",
    "allow-discard-cache-file",
    "allow-write-temp-text-file",
    "allow-pick-videos",
    "allow-pick-output-folder",
    "allow-get-output-folder",
    "allow-list-file-names",
    "allow-path-exists",
    "allow-delete-partial-output",
    "allow-open-file",
    "allow-reveal-in-folder",
    "allow-copy-file-to-clipboard",
    "allow-save-autosave",
    "allow-load-autosave",
    "allow-clear-autosave",
    "allow-save-project",
    "allow-load-project",
    "allow-recording-begin",
    "allow-recording-append",
    "allow-recording-finish",
    "allow-recording-cleanup"
  ]
}
