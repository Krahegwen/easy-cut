{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Easy Cut",
  "mainBinaryName": "easy-cut",
  "version": "../package.json",
  "identifier": "com.krahegwen.easycut",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4850",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Editor de vídeos",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob: mediastream:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob: mediastream:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:4850 http://localhost:4850",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Krahegwen",
    "shortDescription": "Editor de vídeos",
    "longDescription": "Editor de vídeo sencillo para cortar, unir y compartir vídeos.",
    "category": "Video",
    "copyright": "Krahegwen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Krahegwen/easy-cut/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QjMwOTkyREZEODhEMDcKUldRSGpkamZrZ216ZE1kRmY2MkFXWXgrcldGbTZ3Qis2Nlp3VzR3SXdUNTZiSTE5QnA0ZTZod0oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
